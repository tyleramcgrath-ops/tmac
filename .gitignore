/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# seo-intel engine local dev store (FileStore)
.data/

/test-results
/playwright-report
apps/reloop/package-lock.json
apps/north-star-hq/package-lock.json

# citation-gap app deps
apps/citation-gap/node_modules
apps/citation-gap/public
apps/citation-gap/test/*.png

# Packaged social kits: build artefacts of instagram-kit/ and facebook-kit/,
# whose contents are already tracked. Rebuild with `zip -r <name>.zip <dir>`.
/instagram-kit.zip
/facebook-kit.zip

# Theme package and the preview render handed to the client: both are built
# from themes/mcgrath-chrome, which is tracked, so neither belongs in the repo.
# Rebuild with `zip -r mcgrath-chrome.zip mcgrath-chrome` from themes/.
/themes/mcgrath-chrome.zip
/theme-preview-home.png
/surfaces-band.png
/roots-spotlight.png
/roots-resting.png
