# Required for sessions (JWT signing) and credential encryption.
# Generate one with: openssl rand -base64 32
APP_SECRET=

# REQUIRED IN PRODUCTION (and on Vercel preview). PostgreSQL connection
# string. Without it the app falls back to a local JSON file store under the
# OS temp dir, which is per-instance and does NOT survive a serverless cold
# start — accounts, projects, and stored Google credentials silently vanish,
# surfacing as sporadic "Sign in required." 401s. The app therefore refuses
# to start in production without it rather than lose data quietly.
# Vercel's Postgres/Neon integration sets this for you automatically;
# POSTGRES_URL and POSTGRES_PRISMA_URL are also accepted. Migrations run
# themselves on first connect — no manual step.
# Leave unset for local dev/tests to use the file store.
DATABASE_URL=

# Optional — real Google Search Console / Analytics connection (Connect
# Google, in the room's Integrations panel). Create an OAuth 2.0 Client ID in
# the Google Cloud Console (Web application), add
# <your-deployment-origin>/api/oauth/google/callback as an Authorized
# redirect URI, and paste the client ID/secret below. Unset ⇒ the Integrations
# panel says so honestly instead of a dead "Connect" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if the deployment's own origin can't be derived from the
# incoming request (rare — usually leave unset).
GOOGLE_OAUTH_REDIRECT_BASE=

# Optional — the Compass's conversational brain. Points at a Hermes gateway
# exposing an OpenAI-compatible /v1/chat/completions endpoint (`hermes serve`
# with API_SERVER_KEY set). Only the Next.js server reads these; the key is
# never sent to the browser, which is why the room talks to
# /api/compass/chat instead of the gateway directly.
#
# Keep the gateway bound to loopback on its own host and reach it over a
# private network or SSH tunnel — the key authenticates an agent that can run
# tools, not merely a chat model. Unset ⇒ /api/compass/chat returns a 503
# saying so, rather than the room failing with a generic error.
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Optional — lets the Compass's agent read North Star's own data (analytics,
# recommendations, missions, the brief) by calling the same routes the room
# calls, rather than duplicating every engine behind a second machine-only API.
#
# Both must be set or the path stays off entirely. AGENT_SECRET must be at
# least 32 chars; generate one with: openssl rand -hex 32
# AGENT_USER_ID is the id of the single user the agent acts as.
#
# SINGLE-OPERATOR ONLY. This is a full-account bearer credential for that user
# — there is no per-request scoping. Never expose it to a customer-facing
# surface, and never ship it to a browser. A multi-tenant Compass needs
# per-user tokens and a scoped API instead of this.
AGENT_SECRET=
AGENT_USER_ID=
