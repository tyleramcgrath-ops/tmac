# Copy to .env.local for development or set these in your host for production.
# Everything is optional locally; DATABASE_URL and SESSION_SECRET are required in production.

# Postgres connection string. Leave unset locally to use the built-in PGlite database.
DATABASE_URL=

# Signs login cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public URL of the site, used for Stripe redirects.
SITE_URL=http://localhost:3000

# Stripe (Globe+ subscriptions). Leave unset to show the test-mode upgrade instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to "off" to launch without the fictional sample members.
SEED_MEMBERS=
