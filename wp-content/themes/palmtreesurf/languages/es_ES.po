msgstr "Dos estudiantes de surf escuchando las indicaciones antes de entrar al agua"

msgid "Group surf lesson on the beach at Tamarindo"
msgstr "Clase grupal de surf en la playa de Tamarindo"

msgid "Boats and gear at the beach launch point in Tamarindo"
msgstr "Botes y equipo en el punto de salida de la playa en Tamarindo"

msgid "Boat moving through the estuary channel at Tamarindo"
msgstr "Bote avanzando por el canal del estero en Tamarindo"

msgid "A capuchin monkey in the mangroves of the Tamarindo estuary"
msgstr "Un mono carablanca en los manglares del estero de Tamarindo"

msgid "How would you like to pay?"
msgstr "¿Cómo desea pagar?"

msgid "Cash on the day"
msgstr "Efectivo el mismo día"

msgid "Book now, pay when you arrive."
msgstr "Reserve ahora y pague al llegar."

msgid "Pay by card now"
msgstr "Pagar con tarjeta ahora"

msgid "Secure checkout, confirmed straight away."
msgstr "Pago seguro, confirmado al instante."

