# Old suncoastclean.com addresses keep working.
Options -MultiViews
RewriteEngine On
RewriteBase /

RewriteRule ^home/$ / [R=301,L]
RewriteRule ^category/news/$ /news/ [R=301,L]
RewriteRule ^author/admin/$ /news/ [R=301,L]
RewriteRule ^feed/$ /news/ [R=301,L]
RewriteRule ^feed$ /news/ [R=301,L]
RewriteRule ^comments/feed/$ /news/ [R=301,L]
RewriteRule ^carpet-cleaning-in-florida\.aspx$ /carpet-cleaning/ [R=301,L]
RewriteRule ^careers\.aspx$ /now-hiring/ [R=301,L]
RewriteRule ^spring-cleaning\.aspx$ /spring-cleaning-tips/ [R=301,L]
RewriteRule ^cleaning-services-testimonials\.aspx$ /#reviews [R=301,L,NE]
RewriteRule ^admin/pages/leave-a-testimonial-for-suncoast\.aspx$ /contact-us/ [R=301,L]
RewriteRule ^privacy\.aspx$ /privacy/ [R=301,L]
RewriteRule ^vomit\.aspx$ /vomit/ [R=301,L]
RewriteRule ^tar\.aspx$ /tar/ [R=301,L]
RewriteRule ^soda\.aspx$ /soda/ [R=301,L]
RewriteRule ^shoe-polish\.aspx$ /shoe-polish/ [R=301,L]
RewriteRule ^rust\.aspx$ /rust/ [R=301,L]
RewriteRule ^pet-stains\.aspx$ /pet-stains/ [R=301,L]
RewriteRule ^paintvarnish\.aspx$ /paintvarnish/ [R=301,L]
RewriteRule ^oil\.aspx$ /oil/ [R=301,L]
RewriteRule ^nail-polish\.aspx$ /nail-polish/ [R=301,L]
RewriteRule ^mustardketchup\.aspx$ /mustardketchup/ [R=301,L]
RewriteRule ^mud\.aspx$ /mud/ [R=301,L]
RewriteRule ^mildew\.aspx$ /mildew/ [R=301,L]
RewriteRule ^lipstick\.aspx$ /lipstick/ [R=301,L]
RewriteRule ^jamjelly\.aspx$ /jamjelly/ [R=301,L]
RewriteRule ^ink\.aspx$ /ink/ [R=301,L]
RewriteRule ^ice-cream\.aspx$ /ice-cream/ [R=301,L]
RewriteRule ^gum\.aspx$ /gum/ [R=301,L]
RewriteRule ^grass\.aspx$ /grass/ [R=301,L]
RewriteRule ^greasy-food-stains\.aspx$ /greasy-food-stains/ [R=301,L]
RewriteRule ^coffee\.aspx$ /coffee/ [R=301,L]
RewriteRule ^crayon\.aspx$ /crayon/ [R=301,L]
RewriteRule ^cigarette-burns\.aspx$ /cigarette-burns/ [R=301,L]
RewriteRule ^chocolate\.aspx$ /chocolate/ [R=301,L]
RewriteRule ^candy\.aspx$ /candy/ [R=301,L]
RewriteRule ^candle-wax\.aspx$ /candle-wax/ [R=301,L]
RewriteRule ^blood\.aspx$ /blood/ [R=301,L]
RewriteRule ^alcohol\.aspx$ /alcohol/ [R=301,L]
RewriteRule ^acid\.aspx$ /acid/ [R=301,L]
RewriteRule ^get-that-stain-out\.aspx$ /get-that-stain-out/ [R=301,L]
RewriteRule ^royal-palm-beach\.aspx$ /royal-palm-beach/ [R=301,L]
RewriteRule ^west-palm-beach\.aspx$ /west-palm-beach/ [R=301,L]
RewriteRule ^wellington\.aspx$ /wellington/ [R=301,L]
RewriteRule ^boynton-beach\.aspx$ /boynton-beach/ [R=301,L]
RewriteRule ^boca-raton\.aspx$ /boca-raton/ [R=301,L]
RewriteRule ^lake-worth\.aspx$ /lake-worth/ [R=301,L]
RewriteRule ^indiantown\.aspx$ /indiantown/ [R=301,L]
RewriteRule ^stuart\.aspx$ /stuart/ [R=301,L]
RewriteRule ^port-st-lucie\.aspx$ /port-st-lucie/ [R=301,L]
RewriteRule ^palm-beach\.aspx$ /palm-beach/ [R=301,L]
RewriteRule ^jupiter-carpet-cleaning\.aspx$ /jupiter-carpet-cleaning/ [R=301,L]
RewriteRule ^move-in-cleaning\.aspx$ /move-in-cleaning/ [R=301,L]
RewriteRule ^full-home-cleaning\.aspx$ /full-home-cleaning/ [R=301,L]
RewriteRule ^hurricane-clean-up\.aspx$ /hurricane-clean-up/ [R=301,L]
RewriteRule ^green-carpet-cleaning\.aspx$ /green-carpet-cleaning/ [R=301,L]
RewriteRule ^drapery-and-curtain-cleaning\.aspx$ /drapery-and-curtain-cleaning/ [R=301,L]
RewriteRule ^air-duct-cleaning\.aspx$ /air-duct-cleaning/ [R=301,L]
RewriteRule ^shower-stall-cleaning\.aspx$ /shower-stall-cleaning/ [R=301,L]
RewriteRule ^leather-cleaning-and-conditioning\.aspx$ /leather-cleaning-and-conditioning/ [R=301,L]
RewriteRule ^commercial-cleaning-for-southern-florida-businesses\.aspx$ /commercial-cleaning-for-southern-florida-businesses/ [R=301,L]
RewriteRule ^natural-stone-restoration-and-polishing\.aspx$ /natural-stone-restoration-and-polishing/ [R=301,L]
RewriteRule ^water-damage-cleaning\.aspx$ /water-damage-cleaning/ [R=301,L]
RewriteRule ^area-rug-cleaning\.aspx$ /area-rug-cleaning/ [R=301,L]
RewriteRule ^furniture-cleaning-that-gets-out-stains\.aspx$ /furniture-cleaning-that-gets-out-stains/ [R=301,L]
RewriteRule ^tile-and-grout-cleaning\.aspx$ /tile-and-grout-cleaning/ [R=301,L]
RewriteRule ^carpet-cleaning\.aspx$ /carpet-cleaning/ [R=301,L]
RewriteRule ^contact-us\.aspx$ /contact-us/ [R=301,L]
RewriteRule ^locations\.aspx$ /locations/ [R=301,L]
RewriteRule ^news\.aspx$ /news/ [R=301,L]
RewriteRule ^best-cleaning-services-in-florida\.aspx$ /best-cleaning-services-in-florida/ [R=301,L]
RewriteRule ^about-suncoast-carpet-cleaning\.aspx$ /about-suncoast-carpet-cleaning/ [R=301,L]
RewriteRule ^([a-z0-9-]+)\.aspx$ /$1/ [R=301,L]
# /slug.html -> /slug/ (the canonical form), then serve /slug/ from slug.html
RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.html[\s?]
RewriteRule ^([a-z0-9-]+)\.html$ /$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ /$1.html [L]
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|png|css)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
